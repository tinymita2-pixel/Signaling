DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional. Only this Discord user can run owner-only tools if you add them later.
# BOT_OWNER_ID=your_discord_user_id_here

# Optional. Register commands to one or more guilds instantly while testing.
# TEST_GUILD_ID=your_test_server_id_here
# TEST_GUILD_ID=server_id_1,server_id_2,server_id_3

# Optional. Default is Asia/Seoul.
TIMEZONE=Asia/Seoul

# Optional. Put a direct GIF URL here to replace the bundled connecting animation.
# CONNECTING_GIF_URL=https://example.com/connecting.gif
